# Kopiraj u .env.local i popuni vrednostima iz Supabase dashboarda
# (Settings → API). Anon ključ je JAVAN po dizajnu — tajni ključevi se
# nikad ne stavljaju u frontend niti u ovaj repozitorijum.
VITE_SUPABASE_URL=https://tvoj-projekat.supabase.co
VITE_SUPABASE_ANON_KEY=tvoj-anon-kljuc
# Javni VAPID ključ; odgovarajući privatni ključ postoji samo u Supabase secrets.
VITE_VAPID_PUBLIC_KEY=tvoj-vapid-javni-kljuc
